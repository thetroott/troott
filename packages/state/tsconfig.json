{
    "extends": "../../configs/typescript/react-library.json",
    "compilerOptions": {
        "baseUrl": ".",
        "composite": true,
        "incremental": true,
        "declaration": true,
        "declarationMap": true,
        "emitDeclarationOnly": true,
        "noEmit": false,
        "outDir": "dist",
        "rootDir": "src",
        "jsx": "react-jsx"
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
