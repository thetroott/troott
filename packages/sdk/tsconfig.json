{
    "extends": "../../configs/typescript/react-library.json",
    "compilerOptions": {
        "baseUrl": ".",
        "composite": true,
        "incremental": true,
        "declaration": true,
        "declarationMap": true,
        "emitDeclarationOnly": true,
        "noEmit": false,
        "outDir": "dist",
        "rootDir": "src",
        "paths": {
            "@/*": ["./src/*"]
        },
        "types": ["node"]
    },
    "include": ["src", "../../apps/mobile/hooks/services"],
    "exclude": ["node_modules", "dist"]
}
