# Marketing site origin (this Next.js app)
NEXT_PUBLIC_SITE_URL=http://localhost:3051

# Troott API origin (no /api suffix)
NEXT_PUBLIC_APP_API_URL=http://localhost:5025
NEXT_PUBLIC_APP_ENVIRONMENT=development

# Studio / web listener app (apps/web) — production: https://app.troott.com
NEXT_PUBLIC_WEB_APP_URL=http://localhost:5053
NEXT_PUBLIC_GET_TROOTT_PATH=/get-troott

# feat-0003/0005: download CTAs (defaults to enabled in NODE_ENV=development when unset)
NEXT_PUBLIC_GET_TROOTT_ENABLED=true

# Optional external demo URL (e.g. Calendly). Defaults to #minister on homepage when empty.
NEXT_PUBLIC_REQUEST_DEMO_URL=

# MailerLite (server route app/api/subscribe/route.ts — runtime only)
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=
