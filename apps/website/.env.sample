# Troott API origin (no /api suffix). Used by future client calls and build-time public config.
NEXT_PUBLIC_APP_API_URL=http://localhost:5025
NEXT_PUBLIC_APP_ENVIRONMENT=development

# MailerLite (server route `app/api/subscribe/route.ts` — runtime only, not NEXT_PUBLIC_*)
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=
