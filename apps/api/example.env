APP_CHANNELS=
APP_ENV=
API_JSON_BODY_LIMIT=1mb
AWS_ACCESS_KEY_ID=
AWS_BUCKET_NAME=
AWS_ORIGINALS_BUCKET=troott-originals
AWS_PLAYBACK_BUCKET=troott-playback
AWS_STORAGE_BUCKET=troott-storage
# NODE_ENV=staging uses AWS_BUCKET_STAGING for originals/playback/storage (see aws.config.ts)
AWS_BUCKET_STAGING=
AWS_BUCKET_NAME_STAGING=
AWS_REGION=
AWS_SECRET_ACCESS_KEY=
AUDIO_HLS_WORKER_CONCURRENCY=1
# Loudness normalization runs for every sermon before HLS (AUDIO_LOUDNORM_FILTER).
# Optional override: AUDIO_LOUDNORM_FILTER=loudnorm=I=-16:TP=-1.5:LRA=11
CLIENT_APP_URL=
# Staging studio portal (CORS + email). Exact match, no trailing slash (origin.util).
CLIENT_STAGING_URL=
CLIENT_STAGING_BASE_URL=
CLIENT_STAGING_API_URL=
CLIENT_STAGING_PAYMENT_REDIRECT_URL=
CLIENT_STAGING_DASHBOARD_URL=
EMAIL_DOMAIN=
EMAIL_FROM_NAME=
EMAIL_REPLY_TO=
ENCRYPTION_KEY=
GRACEFUL_SHUTDOWN_MS=120000
HLS_WORK_DIR=
JWT_EXPIRY=30d
JWT_SECRET=
MAILERSEND_API_KEY=
MAILERSEND_DOMAIN=
MAILERSEND_STAGING_API_KEY=
MAILERSEND_STAGING_DOMAIN=
CLOUDFRONT_STORAGE_URL=
CLOUDFRONT_PLAYBACK_URL=
MONGODB_URI=
MONGODB_STAGING_URI=
NODE_ENV=
OTP_EXPIRATION_TIME=
PORT=5025
APP_PORT=5025
SERMON_AUDIO_MAX_BYTES=536870912

# Database seeding (dev/staging only). Creates superadmin + roles/plans/topics when true.
ENABLE_SEEDING=false
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_FIRSTNAME=
SUPERADMIN_LASTNAME=

# Local frontend origins (CORS + email links). Match apps/web (5053) and apps/website (3051).
CLIENT_LOCAL_URL=http://localhost:5053
CLIENT_LOCAL_API_URL=http://localhost:5025
CORS_ALLOWED_ORIGINS=http://localhost:5053,http://localhost:3051

# --- Coolify staging (Alpha) — feat-0038 ---
# NODE_ENV=staging
# APP_ENV=staging
# APP_PORT=5025
# MONGODB_STAGING_URI=...
# CLIENT_STAGING_URL=https://app.staging.troott.com
# CLIENT_STAGING_BASE_URL=https://app.staging.troott.com
# CORS_ALLOWED_ORIGINS=https://app.staging.troott.com,https://staging.troott.com
# S3 bucket CORS: AllowedOrigins https://app.staging.troott.com ; ExposeHeaders ETag
# See specs/web/feature/feat-0038 and docs/staging-s3-cors.json.example
