doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(http-equiv="X-UA-Compatible" content="IE=edge")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Pacepard

    style.
      body {
        margin: 0;
        padding: 0;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        background-color: #F8F9FA;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

  body
    table(width="100%" cellpadding="0" cellspacing="0" style="background-color: #F8F9FA; padding: 40px 0;")
      tr
        td(align="center")
          table(width="100%" cellpadding="0" cellspacing="0" style="max-width: 600px; background-color: #FFFFFF;")
            // Logo/Header
            tr
              td(style="padding: 32px 40px 24px; border-bottom: 1px solid #E8EAED;")
                table(width="100%" cellpadding="0" cellspacing="0")
                  tr
                    td
                      img(src="data:image/svg+xml;base64," alt="Pacepard" style="height: 40px; width: auto; display: block; border: 0;")
                       

            // Content Block
            block content

            // Footer
            tr
              td(style="padding: 32px 40px; border-top: 0px solid #E8EAED; background-color:rgb(255, 249, 235);")
                table(width="100%" cellpadding="0" cellspacing="0")
                  // Social Media Icons
                  tr
                    td(style="padding-bottom: 20px;")
                      table(cellpadding="0" cellspacing="0" style="margin: 0;")
                        tr
                          td(style="padding-right: 12px; vertical-align: top;")
                            a(href="https://www.linkedin.com/company/pacepard" style="text-decoration: none; display: inline-block; line-height: 0;")
                              img(src="data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 24 24' fill='%23000000'%3E%3Cpath d='M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z'/%3E%3C/svg%3E" alt="LinkedIn" width="20" height="20" style="width: 20px; height: 20px; display: block; border: 0; max-width: 20px;")
                          td(style="padding-right: 12px; vertical-align: top;")
                            a(href="https://x.com/pacepard" style="text-decoration: none; display: inline-block; line-height: 0;")
                              img(src="data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 24 24' fill='%23000000'%3E%3Cpath d='M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z'/%3E%3C/svg%3E" alt="X" width="20" height="20" style="width: 20px; height: 20px; display: block; border: 0; max-width: 20px;")
                          td(style="vertical-align: top;")
                            a(href="https://youtube.com/pacepard" style="text-decoration: none; display: inline-block; line-height: 0;")
                              img(src="data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 24 24' fill='%23000000'%3E%3Cpath d='M23.498 6.186a3.016 3.016 0 0 0-2.118-2.114C18.506 3.418 12 3.418 12 3.418s-6.506 0-9.38.654a3.015 3.015 0 0 0-2.118 2.114C0 9.066 0 12.001 0 12.001s0 2.935.654 5.815a3.016 3.016 0 0 0 2.118 2.114c2.868.654 9.374.654 9.374.654s6.506 0 9.374-.654a3.015 3.015 0 0 0 2.118-2.114C24 14.936 24 12.001 24 12.001s0-2.935-.652-5.815zm-13.746 8.674V8.134l6.266 3.329-6.266 3.397z'/%3E%3C/svg%3E" alt="YouTube" style="width: 20px; height: 20px; display: block; border: 0; max-width: 20px;")
                  
                  // Footer Links
                  tr
                    td(style="padding-bottom: 16px;")
                      table(width="100%" cellpadding="0" cellspacing="0")
                        tr
                          td(style="font-size: 12px; line-height: 20px; color: #5F6368; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;")
                            a(href="#" style="color: #1A73E8; text-decoration: underline; white-space: nowrap;") Privacy Policy
                            span(style="color: #DADCE0; padding: 0 8px;") &middot;
                            a(href="#" style="color: #1A73E8; text-decoration: underline; white-space: nowrap;") Terms of Service
                            span(style="color: #DADCE0; padding: 0 8px;") &middot;
                            a(href="#" style="color: #1A73E8; text-decoration: underline; white-space: nowrap;") Unsubscribe
                  
                  // Copyright
                  tr
                    td
                      p(style="margin: 0; font-size: 12px; line-height: 18px; color: #5F6368; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;")
                        | &copy; #{new Date().getFullYear()} Pacepard. All rights reserved.
