extends ../../base-email

block content
  tr
    td(style="padding: 40px 40px 32px;")
      // Heading
      h1(style="margin: 0 0 24px; font-size: 24px; font-weight: 400; line-height: 32px; color: #202124; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;") Password changed successfully
      
      // Greeting
      p(style="margin: 0 0 16px; font-size: 14px; line-height: 20px; color: #202124; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;")
        | Hi 
        span(style="font-weight: 500;")= (user && user.firstName) ? user.firstName : 'there'
        | ,
      
      // Main message
      p(style="margin: 0 0 24px; font-size: 14px; line-height: 20px; color: #5F6368; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;")
        | Your password has been successfully changed. Your Pacepard account is now secure with your new password.
      
      // Info box
      p(style="margin: 24px 0; padding: 16px; background-color: #F8F9FA; border-left: 3px solid #1A73E8; font-size: 14px; line-height: 20px; color: #5F6368; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;")
        | If you did not make this change, please contact our support team immediately to secure your account.
      
      // Disclaimer
      p(style="margin: 32px 0 0; font-size: 14px; line-height: 20px; color: #5F6368; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; text-align: left;")
        | For your security, we recommend using a strong, unique password for your account.
