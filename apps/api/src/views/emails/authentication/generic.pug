extends ../../base-email

block content
  tr
    td(style="padding: 40px 40px 32px;")
      // Heading
      h1(style="margin: 0 0 20px; font-size: 24px; font-weight: 600; line-height: 32px; color: #202124; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; text-align: left;")= subject || 'Hello from Pacepard'
      
      // Salute
      if salute
        p(style="margin: 0 0 20px; font-size: 14px; line-height: 20px; color: #202124; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; text-align: left;")
          != salute
      
      // Body One
      if bodyOne
        p(style="margin: 0 0 20px; font-size: 14px; line-height: 20px; color: #5F6368; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; text-align: left;")
          != bodyOne
      
      // OTP Code if provided
      if code
        table(cellpadding="0" cellspacing="0" style="margin: 32px 0 0; width: 100%;")
          tr
            td(align="left" style="padding: 0;")
              table(cellpadding="0" cellspacing="0" style="background-color: #F5F5F5; border-radius: 8px; padding: 32px 40px;")
                tr
                  td(align="left" style="padding: 0;")
                    p(style="margin: 0; font-size: 48px; font-weight: 700; line-height: 1.2; color: #202124; letter-spacing: 2px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; text-align: left;")= code
      
      // Body Two
      if bodyTwo
        p(style="margin: 32px 0 0; font-size: 14px; line-height: 20px; color: #5F6368; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; text-align: left;")
          != bodyTwo
      
      // Body Three
      if bodyThree
        p(style="margin: 20px 0 0; font-size: 14px; line-height: 20px; color: #5F6368; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; text-align: left;")
          != bodyThree
      
      // Button if provided
      if buttonUrl && buttonText
        table(cellpadding="0" cellspacing="0" style="margin: 32px 0 0;")
          tr
            td(align="left" style="padding: 0;")
              a(href=buttonUrl style="display: inline-block; padding: 12px 24px; background-color: #1A73E8; color: #FFFFFF; text-decoration: none; border-radius: 4px; font-size: 14px; font-weight: 500; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;")= buttonText
