{
    "name": "@troott/api",
    "private": true,
    "main": "server.ts",
    "exports": {
        "./enums": "./src/types/common.enum.ts"
    },
    "version": "1.0.0",
    "scripts": {
        "clean": "rimraf dist",
        "clean:js": "find src -name '*.js' -type f -delete",
        "prebuild": "pnpm clean",
        "dev": "ts-node-dev -r tsconfig-paths/register --respawn --transpile-only src/server.ts",
        "build": "tsc --noEmit false && copyfiles -u 1 src/_data/**/* dist/ && copyfiles -u 1 src/views/**/* dist/",
        "start": "node dist/server.js",
        "staging": "NODE_ENV=staging node dist/server.js",
        "prod": "NODE_ENV=production node dist/server.js",
        "pm2:staging": "pm2 start dist/server.js --name troott-staging --env staging",
        "pm2:prod": "pm2 start dist/server.js --name troott-prod --env production",
        "pm2:restart": "pm2 restart all",
        "pm2:logs": "pm2 logs",
        "test": "jest --config jest.config.ts",
        "test:watch": "jest --config jest.config.ts --watch",
        "test:coverage": "jest --config jest.config.ts --coverage",
        "test:ci": "jest --config jest.config.ts --ci --coverage --maxWorkers=2"
    },
    "keywords": [
        "troott",
        "Sermon Streaming App"
    ],
    "author": "team-streamsqr",
    "license": "ISC",
    "description": "> StreamSqr provides audio streaming services worldwide, with a premium subscription offering and free ad-supported plan. The Premium segment offers unlimited online and offline streaming access to its catalogue of sermon, and sermon reels without commercial break.",
