# API server origin only (no path required). Client code appends `/api/v1`.
VITE_APP_API_URL=http://localhost:3000
# Profile page: leave unset or `false` to use built-in dummy data (no API). Set to
# `true` when `GET/PUT /profile/me` is available.
# VITE_PROFILE_USE_REAL_API=true
VITE_API_URL_LOCAL=https://api.example.com
VITE_API_URL_PROD=https://api.example.com
VITE_APP_NAME=troott
VITE_DEBUG=true
VITE_VERSION=1.0.0

# Public asset origin (CDN or S3 website endpoint) used by `resolveAssetUrl`
# to convert stored `s3Key`s into displayable URLs. If unset, the util falls
# back to the AWS S3 default origin using `VITE_S3_BUCKET` + `VITE_S3_REGION`.
# VITE_ASSET_BASE_URL=https://cdn.example.com
# VITE_S3_BUCKET=troott-assets
# VITE_S3_REGION=us-east-1