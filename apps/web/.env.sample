# API server origin only (no path required). Client code appends `/api/v1`.
# Omit in dev to use a localhost placeholder; sermon upload is then mocked for UI work.
VITE_APP_API_URL=http://localhost:3000
# Legacy alias for the same value (optional if VITE_APP_API_URL is set)
# VITE_API_BASE_URL=http://localhost:3000
# In dev only: set to "true" when the API is running and you want a real upload request.
# VITE_USE_REAL_API_UPLOAD=true
VITE_API_URL_LOCAL=https://api.example.com
VITE_API_URL_PROD=https://api.example.com
VITE_APP_NAME=troott
VITE_DEBUG=true
VITE_VERSION=1.0.0