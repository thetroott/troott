# API server origin only (no /api path). Client appends `/api/v1` in `api/config.tsx`.
VITE_APP_API_URL=http://localhost:5025

# When `"prod"`, Sentry, PostHog, and Vercel Speed Insights load in `main.tsx`.
VITE_APP_ENVIRONMENT=development

# Optional observability (leave empty in local dev)
VITE_APP_PUBLIC_SENTRY_DSN=
VITE_APP_PUBLIC_POSTHOG_KEY=
VITE_APP_PUBLIC_POSTHOG_HOST=

# Upload pipeline toggles
VITE_USE_REAL_API_UPLOAD=false
VITE_DEPLOYMENT_REGION=us-east-1

# get-troott redirect targets (feat-0035 — scripts/generate-get-troott-html.mjs)
VITE_TROOTT_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.troott.app
VITE_TROOTT_APP_STORE_URL=https://apps.apple.com/ng/app/troott/id1234567890
VITE_TROOTT_WEB_APP_URL=http://localhost:5053
# Empty dmg/exe fall back to VITE_TROOTT_WEB_APP_URL in generated get-troott.html
VITE_TROOTT_DMG_URL=
VITE_TROOTT_EXE_URL=
