{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "app",
    "api",
    "assets",
    "components",
    "constants",
    "_data",
    "dtos",
    "engine",
    "hooks",
    "lib",
    "screens",
    "services",
    "stores",
    "types",
    "utils",
    "validation",
    "app.config.tsx",
    "**/*.ts",
    "**/*.tsx",
    "metro.config.js",
    "nativewind-env.d.ts"
  ],
  "moduleResolution": "nodenext"
}