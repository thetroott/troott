    "expo": {
        "doctor": {
            "reactNativeDirectoryCheck": {
                "listUnknownPackages": false,
                "exclude": [
                    "react-native-dotenv",
                    "react-native-fs",
                    "react-native-heroicons",
                    "react-native-iphone-x-helper",
                    "react-native-modals",
                    "react-native-system-setting"
