    },
    "license": "ISC",
    "author": "troott technologies",
    "type": "commonjs",
    "main": "index.ts",
    "scripts": {
        "dev": "expo start --port 8177",
        "start": "expo start --port 8177",
        "start:clear": "expo start --port 8177 -c",
        "android": "expo run:android --port 8177",
        "ios": "expo run:ios --port 8177",
        "ios:open-dev-client": "bash ./scripts/open-ios-dev-client.sh",
        "ios:resilient": "expo run:ios --port 8177; bash ./scripts/open-ios-dev-client.sh",
        "web": "expo start --web",
        "prebuild": "expo prebuild .",
        "prebuild:clean": "expo prebuild . --clean"
