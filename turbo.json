{
    "$schema": "https://turbo.build/schema.json",
    "dangerouslyDisablePackageManagerCheck": true,
    "ui": "tui",
    "globalEnv": [
        "APP_ENV",
        "ENABLE_SEEDING",
        "SUPERADMIN_EMAIL",
        "SUPERADMIN_PASSWORD",
        "SUPERADMIN_FIRSTNAME",
        "SUPERADMIN_LASTNAME",
        "NODE_ENV",
        "MAILERLITE_API_KEY",
        "MAILERLITE_GROUP_ID"
    ],
    "tasks": {
        "lint": {
            "outputs": [],
            "env": [
                "APP_ENV",
                "CLIENT_APP_URL",
                "CLIENT_API_URL",
                "CLIENT_PAYMENT_REDIRECT_URL",
                "CLIENT_DASHBOARD_URL",
                "CLIENT_STAGING_BASE_URL",
                "CLIENT_STAGING_API_URL",
                "CLIENT_STAGING_PAYMENT_REDIRECT_URL",
                "CLIENT_STAGING_DASHBOARD_URL",
                "CLIENT_STAGING_URL",
                "CLIENT_LOCAL_URL",
                "CLIENT_LOCAL_API_URL",
                "CLIENT_LOCAL_PAYMENT_REDIRECT_URL",
                "CLIENT_LOCAL_DASHBOARD_URL",
                "MAILERLITE_API_KEY",
                "MAILERLITE_GROUP_ID"
            ]
        },
        "test": {
            "inputs": ["**/*.{ts,tsx,js,jsx}"],
            "env": [
                "AWS_REGION",
                "AWS_ACCESS_KEY_ID",
                "AWS_SECRET_ACCESS_KEY",
                "AWS_STORAGE_BUCKET",
                "CLOUDFRONT_STORAGE_URL",
                "JWT_SECRET"
            ]
        },
        "build": {
            "dependsOn": ["^build"],
            "env": [
                "APP_ENV",
                "AWS_REGION",
                "AWS_ACCESS_KEY_ID",
                "AWS_SECRET_ACCESS_KEY",
                "AWS_STORAGE_BUCKET",
                "AWS_ORIGINALS_BUCKET",
                "AWS_PLAYBACK_BUCKET",
                "AWS_BUCKET_STAGING",
                "AWS_BUCKET_DEVELOPMENT",
                "CLOUDFRONT_STORAGE_URL",
                "CLIENT_APP_URL",
                "CLIENT_API_URL",
                "CLIENT_PAYMENT_REDIRECT_URL",
                "CLIENT_DASHBOARD_URL",
                "CLIENT_STAGING_BASE_URL",
                "CLIENT_STAGING_API_URL",
                "CLIENT_STAGING_PAYMENT_REDIRECT_URL",
                "CLIENT_STAGING_DASHBOARD_URL",
                "CLIENT_STAGING_URL",
                "CLIENT_LOCAL_URL",
                "CLIENT_LOCAL_API_URL",
                "CLIENT_LOCAL_PAYMENT_REDIRECT_URL",
                "CLIENT_LOCAL_DASHBOARD_URL",
                "VITE_APP_API_URL",
                "VITE_APP_ENVIRONMENT",
                "VITE_TROOTT_PLAY_STORE_URL",
                "VITE_TROOTT_APP_STORE_URL",
                "VITE_TROOTT_WEB_APP_URL",
                "VITE_TROOTT_DMG_URL",
                "VITE_TROOTT_EXE_URL",
                "NEXT_PUBLIC_APP_API_URL",
                "NEXT_PUBLIC_APP_ENVIRONMENT"
            ],
            "outputs": [
                "dist/**",
                ".next/**",
                "!.next/cache/**",
                "build/**",
                "node_modules/.cache/metro/**"
            ]
        },
        "dev": {
            "cache": false,
            "persistent": true
        }
    }
}
